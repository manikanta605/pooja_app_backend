PORT=4000
JWT_SECRET=change-this-to-a-strong-random-secret-in-production
DB_PATH=./data/pujadiary.db
ALLOW_DEV_OTP=true

# SMTP Email configuration for Forgot Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="PujaDiary <your-email@gmail.com>"

# Free WhatsApp OTP (Option 1: Meta WhatsApp Cloud API - free test/tier at developers.facebook.com)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en

# Free WhatsApp OTP (Option 2: Free webhook / local Baileys bridge URL)
WHATSAPP_WEBHOOK_URL=
